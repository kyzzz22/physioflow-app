{
  "name": "physioflow-app",
  "private": true,
  "version": "0.4.0",
  "description": "Visual experiment workflow system for behavioral and physiological research",
  "author": "PhysioFlow",
  "type": "module",
  "scripts": {
    "dev": "npx vite --port 5174",
    "build": "npx vite build",
    "package:web": "node build-web.cjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "hosted:serve": "node server/hostedServer.mjs",
    "hosted:backup": "node server/hostedBackupCli.mjs create",
    "hosted:backup:verify": "node server/hostedBackupCli.mjs verify",
    "hosted:restore": "node server/hostedBackupCli.mjs restore",
    "lint": "npx eslint src server",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e-cdp.mjs",
    "test:refactor-e2e": "node --test tests/refactor-e2e.test.js",
    "test:e2e:refactor-browser": "node tests/e2e-composer-v2-self-hosted.mjs",
    "test:e2e:participant-public": "node tests/e2e-participant-public.mjs",
    "test:performance": "node --test tests/performance-gates.test.js",
    "validate:graph-export": "node scripts/validate-graph-export.mjs",
    "verify:usability-study": "node scripts/verify-usability-study.mjs",
    "migrate:v1": "node scripts/migrate-protocol-v1.mjs",
    "quality:refactor": "npm test && npm run build && npm run lint -- --max-warnings=0",
    "quality:release": "npm run quality:refactor && npm run test:e2e && npm run test:e2e:refactor-browser && npm run test:e2e:participant-public"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
